# Neon PostgreSQL connection string
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Must be at least 32 characters long — used to encrypt session cookies
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# Discord webhook URL for the weekly "caretaker not updated" reminder
# (Discord channel → Edit Channel → Integrations → Webhooks → New Webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# Random secret shared with Vercel Cron so only Vercel can trigger
# /api/cron/notify-not-updated (Vercel sends it as "Authorization: Bearer <value>")
CRON_SECRET=change_this_to_another_long_random_string
