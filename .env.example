# Neon PostgreSQL connection string
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Must be at least 32 characters long — used to encrypt session cookies
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars
